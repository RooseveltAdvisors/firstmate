===== 2. process-event runner on a state root another script created under umask 002 =====
$ ls -ld $H/state   # plain mkdir under umask 002, as fm-bootstrap.sh does
drwxrwxr-x 2 jon jon 4096 Oct  2 01:09 /tmp/fm-lab-sharedstate.uEEmzX/state
$ FM_HOME=$H bin/fm-procevent.sh list
no sources registered
rc=0
$ ls -ld $H/state   # established private, not refused
drwxr-xr-x 2 jon jon 4096 Oct  2 01:09 /tmp/fm-lab-sharedstate.uEEmzX/state
$ repeat (idempotence)
rc=0
drwxr-xr-x 2 jon jon 4096 Oct  2 01:09 /tmp/fm-lab-sharedstate.uEEmzX/state

-- adversarial: a root that cannot be tightened still fails closed
$ PATH=<chmod-exits-1 shim>:$PATH FM_HOME=$HB bin/fm-procevent.sh list
error: process-event state root is not a private directory
rc=1
drwxrwxr-x 2 jon jon 4096 Oct  2 01:09 /tmp/fm-lab-unfixable.le1jKQ/state

-- adversarial: a root another user owns is refused, mode untouched
$ PATH=<id-reports-foreign-uid shim>:$PATH FM_HOME=$HC bin/fm-procevent.sh list
error: process-event state root is not a private directory
rc=1
drwxrwxr-x 2 jon jon 4096 Oct  2 01:09 /tmp/fm-lab-foreign.cCVdPP/state

