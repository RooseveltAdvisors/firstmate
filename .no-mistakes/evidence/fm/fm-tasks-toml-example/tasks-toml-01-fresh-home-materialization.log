# Scenario: fresh home bootstrap materializes .tasks.toml from the tracked example
$ LAB=$(mktemp -d ${TMPDIR:-/tmp}/fm-lab.XXXXXX); bin/fm-lab-home.sh create "$LAB"  # -> /tmp/fm-lab.xQYDTa
$ env -u NO_MISTAKES_GATE -u FM_GATE_REFUSE_BYPASS -u FM_ROOT_OVERRIDE -u FM_STATE_OVERRIDE -u FM_DATA_OVERRIDE -u FM_CONFIG_OVERRIDE -u FM_PROJECTS_OVERRIDE FM_HOME="$LAB" FM_BACKEND=tmux bash bin/fm-bootstrap.sh
(exit 0; full stdout below)
