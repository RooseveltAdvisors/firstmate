{
  "version": 1,
  "stage": 1,
  "launchEnabled": false,
  "policy": {
    "id": "model-forge-packages-v1",
    "mode": "deny-all",
    "allowedDomains": [
      "api.openai.com",
      "github.com",
      "api.github.com",
      "registry.npmjs.org",
      "registry-1.docker.io"
    ],
    "deniedDomains": [
      "*.arcs.health",
      "*.zeta.health",
      "*.covenant.clinic",
      "*.home.arcs.internal",
      "*.internal",
      "dev",
      "srv",
      "svc",
      "gpu"
    ],
    "denyPrivateNetworks": true,
    "hostDockerSocket": false,
    "hostMounts": [],
    "workspaceMode": "disposable-committed-clone",
    "secretMode": "sandbox-scoped-ephemeral",
    "persistentAuth": false,
    "sharedSkills": false
  },
  "hosts": [
    {
      "id": "dev",
      "role": "dev",
      "transport": "local",
      "hostname": "dev",
      "enabled": false,
      "priority": 10,
      "cpus": 8,
      "memory": "16GiB",
      "maxConcurrent": 3,
      "profile": "model-forge-packages-v1",
      "authMode": "ephemeral-only",
      "privateNetworkGrant": false
    },
    {
      "id": "agt-01",
      "role": "agt",
      "transport": "ssh-fixed",
      "hostname": "agt-01",
      "enabled": false,
      "priority": 20,
      "cpus": 4,
      "memory": "8GiB",
      "maxConcurrent": 1,
      "profile": "model-forge-packages-v1",
      "authMode": "ephemeral-only",
      "privateNetworkGrant": false
    },
    {
      "id": "gpu",
      "role": "gpu",
      "transport": "ssh-fixed",
      "hostname": "gpu",
      "enabled": false,
      "priority": 90,
      "cpus": 4,
      "memory": "8GiB",
      "maxConcurrent": 1,
      "profile": "model-forge-packages-v1",
      "authMode": "ephemeral-only",
      "privateNetworkGrant": false
    },
    {
      "id": "svc",
      "role": "svc",
      "transport": "ssh-fixed",
      "hostname": "svc",
      "enabled": false,
      "priority": 80,
      "cpus": 2,
      "memory": "4GiB",
      "maxConcurrent": 1,
      "profile": "model-forge-packages-v1",
      "authMode": "ephemeral-only",
      "privateNetworkGrant": false
    },
    {
      "id": "srv",
      "role": "srv",
      "transport": "ssh-fixed",
      "hostname": "srv",
      "enabled": false,
      "priority": 100,
      "cpus": 2,
      "memory": "4GiB",
      "maxConcurrent": 1,
      "profile": "model-forge-packages-v1",
      "authMode": "ephemeral-only",
      "privateNetworkGrant": false
    }
  ]
}
